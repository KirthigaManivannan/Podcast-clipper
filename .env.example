# ============================================================================
#  PodClip configuration
#  The ONLY required setting is your OpenRouter API key.
#  Get a free key at https://openrouter.ai/keys then paste it after the "=".
# ============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ----------------------------------------------------------------------------
#  Optional overrides (uncomment a line to change a default)
# ----------------------------------------------------------------------------
# PRIMARY_MODEL=qwen/qwen3:free
# FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-chat:free
# WHISPER_MODEL=base
# NUM_CLIPS=5
# CLIP_MIN_SECONDS=20
# CLIP_MAX_SECONDS=45
