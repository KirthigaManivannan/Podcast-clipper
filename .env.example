# ============================================================================
#  PodClip configuration
#  The ONLY required setting is your OpenRouter API key.
#  Get a free key at https://openrouter.ai/keys then paste it after the "=".
# ============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ----------------------------------------------------------------------------
#  Optional overrides (uncomment a line to change a default)
# ----------------------------------------------------------------------------
# PRIMARY_MODEL=qwen/qwen3:free
# FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-chat:free
# WHISPER_MODEL=base
# NUM_CLIPS=5
# CLIP_MIN_SECONDS=20
# CLIP_MAX_SECONDS=45

# Optional: path to a Netscape-format cookies.txt for authenticated downloads
# (e.g. exported from your browser) — fixes YouTube's "not a bot" bot-check
# that often hits cloud/sever IPs. Leave unset for anonymous downloads.
# COOKIES_FILE=/path/to/cookies.txt
#
# OR, on platforms where uploading a file is awkward (e.g. Render), set
# COOKIES_B64 to the base64-encoded contents of that same cookies.txt.
# COOKIES_B64=eyJ...==
#
# On this machine PodClip also automatically picks up `.config/cookies.txt`
# (written by `python scripts/export_cookies.py`) with no env var needed.
